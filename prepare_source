# vim: ft=bash

# release tag from https://github.com/gardenlinux/package-libvirt/tags
LIBVIRT_VERSION_TAG="gardenlinux-release-26-07-14"
version_increment="0"

DATE_OF_TAG="${LIBVIRT_VERSION_TAG//[^0-9]/}"
UPSTREAM_VERSION="12.2.0"
DEBIAN_REVISION="1"

git_src_commit "$LIBVIRT_VERSION_TAG" https://github.com/cyberus-technology/libvirt.git

# debian specific things
crd=$(mktemp -d)
git clone --branch "debian/${UPSTREAM_VERSION}-${DEBIAN_REVISION}" --single-branch https://salsa.debian.org/libvirt-team/libvirt.git "$crd"
pushd "$crd"
git branch
cp -r debian "$dir/src/"
popd
rm -rf "$crd"

sed "s/SED_MARKER_FOR_COMMIT_SHA/$LIBVIRT_VERSION_TAG/" <upstream_patches/meson.build.patch.tpl >upstream_patches/meson.build.patch

apply_patches
import_upstream_patches

# set variables for gardenlinux package build
version="${UPSTREAM_VERSION}" # current debian base (do not change for rebuilds)
version_suffix="+${DATE_OF_TAG}-${DEBIAN_REVISION}gl${version_increment}~bp1877"
message="Update to $version $version_suffix"
