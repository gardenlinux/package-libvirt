# vim: ft=bash
#
# commit sha from https://github.com/cyberus-technology/libvirt/commits/gardenlinux-staging/
LIBVIRT_COMMIT_SHA="6a88b797dd307111ae6c746c478ff41f742de67b"
version_increment="0"

UPSTREAM_VERSION="12.7.0"
DEBIAN_REVISION="1"

git_src_commit "$LIBVIRT_COMMIT_SHA" https://github.com/cyberus-technology/libvirt.git

# debian specific things
crd=$(mktemp -d)
git clone --branch "debian/${UPSTREAM_VERSION}-${DEBIAN_REVISION}" --single-branch https://salsa.debian.org/libvirt-team/libvirt.git "$crd"
pushd "$crd"
git branch
cp -r debian "$dir/src/"
popd
rm -rf "$crd"

sed "s/SED_MARKER_FOR_COMMIT_SHA/$LIBVIRT_COMMIT_SHA/" <upstream_patches/meson.build.patch.tpl >upstream_patches/meson.build.patch

apply_patches
import_upstream_patches

version="${UPSTREAM_VERSION}" # current debian base (do not change for rebuilds)
version_suffix="-${DEBIAN_REVISION}gl${version_increment}~sta1877"
message="Update to $version $version_suffix"
